{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oblita",
  "account_id": "e270a2e902b37cc9c371a473a0de188f",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "oblita.giuli.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/signal", "/healthz"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SIGNAL", "class_name": "SignalRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SignalRoom"] }],
  "observability": { "enabled": true }
}
